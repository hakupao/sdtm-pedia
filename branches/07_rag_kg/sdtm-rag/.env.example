# sdtm-rag — environment variables example
# Copy to `.env` and fill in real keys. `.env` is gitignored (R-17).
# NEVER commit real keys; rotate immediately if leaked.

# ─────────── LLM provider API keys (LiteLLM Router) ───────────
# Primary RAG model: claude-sonnet-4-6 (per PLAN §4.2 D-2)
ANTHROPIC_API_KEY=

# Cross-check / fallback: deepseek-v4-pro **non-thinking** mode (D-4 v2 2026-05-22 用户选 V4-Pro)
# Non-thinking 强制, 避 LiteLLM Issue #26395 (V4-Pro thinking 模式 multi-turn bug, R-8)
DEEPSEEK_API_KEY=

# (留接口预留, 暂不使用; D-3 + D-4 v2 2026-05-22 用户决策)
# OpenAI API account 暂未开; embedding 主路径改 bge-m3 local 不需要此 key.
# 后续若决定切回 OpenAI embedding, 取消注释并填值, 再设 SDTM_RAG_EMBEDDING_MODEL=openai/text-embedding-3-small
# OPENAI_API_KEY=
# OPENAI_API_BASE=  # 可选: 用第三方 OpenAI-compatible proxy 时填; 生产环境不推荐

# Optional: Cohere Rerank (Phase 1B.2 may use Top-K rerank)
COHERE_API_KEY=

# Optional: HuggingFace Hub (bge-m3 model 是 open weight, 一般无需 token; 若 rate-limited 填)
# HUGGINGFACE_HUB_TOKEN=

# ─────────── Application config ───────────
# Data directory (chroma persist + uploaded datasets); default = ./data
SDTM_RAG_DATA_DIR=./data

# Chroma persistent dir
SDTM_RAG_CHROMA_DIR=./data/chroma

# Default LLM model id (LiteLLM identifier)
SDTM_RAG_DEFAULT_MODEL=anthropic/claude-sonnet-4-6
SDTM_RAG_FALLBACK_MODEL=deepseek/deepseek-v4-pro      # 非思考模式 (D-4 v2)
SDTM_RAG_HARD_MODEL=anthropic/claude-opus-4-7
SDTM_RAG_LIGHT_MODEL=anthropic/claude-haiku-4-5

# Embedding (D-4 v2: bge-m3 local main, sentence-transformers; 1024d)
# 切回 OpenAI text-embedding-3-small 时: 改 EMBEDDING_MODEL=openai/text-embedding-3-small + EMBEDDING_DIM=1536 + 填 OPENAI_API_KEY
SDTM_RAG_EMBEDDING_MODEL=BAAI/bge-m3
SDTM_RAG_EMBEDDING_DIM=1024
SDTM_RAG_EMBEDDING_DEVICE=mps   # Mac M-series; Docker Linux 用 'cpu' 或 'cuda' (有 GPU)

# Logging
SDTM_RAG_LOG_LEVEL=INFO

# Server-side dataset upload cap (per PLAN §5 Phase 1C.1, F-12)
SDTM_RAG_MAX_UPLOAD_MB=100
SDTM_RAG_DATASET_CHUNKSIZE=10000
