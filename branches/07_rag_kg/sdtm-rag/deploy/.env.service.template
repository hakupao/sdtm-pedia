# Service-dir .env for ~/MyProject/sdtm-rag-service (DEPLOY_PLAN.md §3). chmod 600, NEVER commit.
# Copied here by deploy.sh on first run; fill in the secrets, then load the LaunchAgent.

# ── Provider API keys (copy the real values from the repo .env) ──
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
COHERE_API_KEY=

# ── Self-contained paths (deploy.sh bakes __SERVICE_DIR__ -> the real $DEST on seed) ──
SDTM_RAG_KB_ROOT=__SERVICE_DIR__/knowledge_base
SDTM_RAG_CHROMA_DIR=__SERVICE_DIR__/data/chroma

# ── Login gate (generate with: python -m scripts.gen_password_hash) ──
SDTM_RAG_AUTH_ENABLED=true
SDTM_RAG_SHARED_PASSWORD_HASH=
SDTM_RAG_SESSION_SECRET=

# ── Hardening (ON for sharing) ──
SDTM_RAG_SANITIZE_ERRORS=true
SDTM_RAG_RATE_LIMIT_ENABLED=true
SDTM_RAG_RATE_LIMIT_PER_MIN=30
SDTM_RAG_RATE_LIMIT_BURST=10
# Only set true if a trusted reverse proxy overwrites X-Forwarded-For (§6). Direct 8000 = false.
SDTM_RAG_RATE_LIMIT_TRUST_FORWARDED=false

# Main model stays DeepSeek V4 Pro (phase-2 decision); no change needed here.
# SDTM_RAG_DEFAULT_MODEL=deepseek/deepseek-v4-pro
