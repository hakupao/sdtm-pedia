# sdtm-rag — environment variables example
# Copy to `.env` and fill in real keys. `.env` is gitignored (R-17).
# NEVER commit real keys; rotate immediately if leaked.

# ─────────── LLM provider API keys (LiteLLM Router) ───────────
# Primary RAG model: claude-sonnet-4-6 (per PLAN §4.2 D-2)
ANTHROPIC_API_KEY=

# Cross-check / fallback: deepseek-v4-pro **non-thinking** mode (D-4 v2 2026-05-22 用户选 V4-Pro)
# Non-thinking 强制, 避 LiteLLM Issue #26395 (V4-Pro thinking 模式 multi-turn bug, R-8)
DEEPSEEK_API_KEY=

# Embedding: OpenAI text-embedding-3-small (D-4 v3 2026-05-23 决策: 本地模型崩溃, 改云端)
OPENAI_API_KEY=
# OPENAI_API_BASE=  # 可选: 用第三方 OpenAI-compatible proxy 时填

# Cohere Rerank (T2: wide retrieve -> rerank -> top_k). Get a free trial key at
# https://dashboard.cohere.com/ -> API Keys. Required only when rerank is enabled.
COHERE_API_KEY=


# ─────────── Application config ───────────
# Data directory (chroma persist + uploaded datasets); default = ./data
SDTM_RAG_DATA_DIR=./data

# Chroma persistent dir
SDTM_RAG_CHROMA_DIR=./data/chroma

# Default LLM model id (LiteLLM identifier)
SDTM_RAG_DEFAULT_MODEL=anthropic/claude-sonnet-4-6
SDTM_RAG_FALLBACK_MODEL=deepseek/deepseek-v4-pro      # 非思考模式 (D-4 v2)
SDTM_RAG_HARD_MODEL=anthropic/claude-opus-4-7
SDTM_RAG_LIGHT_MODEL=anthropic/claude-haiku-4-5

# Embedding (D-4 v3: OpenAI cloud; 1536d)
SDTM_RAG_EMBEDDING_MODEL=text-embedding-3-small
SDTM_RAG_EMBEDDING_DIM=1536

# Rerank (T2): enable wide-pool Cohere rerank. CLI --rerank overrides at eval time.
SDTM_RAG_RERANK_ENABLED=false
SDTM_RAG_RERANK_MODEL=rerank-v3.5
SDTM_RAG_RERANK_CANDIDATES=100

# Logging
SDTM_RAG_LOG_LEVEL=INFO

# Server-side dataset upload cap (per PLAN §5 Phase 1C.1, F-12)
SDTM_RAG_MAX_UPLOAD_MB=100
SDTM_RAG_DATASET_CHUNKSIZE=10000

# ─────────── Neo4j 探索层 (SP4; localhost-only, 不进 go-live) ───────────
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ─────────── 联网参考通道 (spec 2026-08-31; 默认关, 每次请求显式开) ───────────
# 搜索供应商 key。**没有它整条通道静默降级为"未联网"** (web_status=disabled),
# 答案照常出但只基于知识库 —— 前端会显式提示, 不会假装联网了。
# 申请: https://tavily.com  (免费档可用于验证; 按次计费, 注意下面的日配额)
TAVILY_API_KEY=

# 本开关决定 Rule 9 (联网内容的反捏造边界) 是否进 system prompt。
# 关掉 ⇒ system prompt 与本功能引入前**逐字节相同** (A/B 回滚, 同 prompt_guardrail 先例)。
# ⚠ 与请求级的 `web` 字段是两回事: 请求级只决定是否把 web_search 工具挂上去, 不动 prompt。
SDTM_RAG_WEB_SEARCH_ENABLED=true

# 工具循环上限 (用户裁定 2026-08-31)。跑满一题可能 1-2 分钟。
# ⚠ 循环总时长不受 llm_config.py 的 Router timeout=120 约束 (那是单次调用上限);
#    反代/前端的总超时须另行确认, 否则跑满时会断在半路。
SDTM_RAG_WEB_MAX_ROUNDS=5
SDTM_RAG_WEB_MAX_SEARCHES=15

# 每次搜索取回条数与单条正文截断 —— 上下文预算闸。
# 实测: 单条正文 1350-2869 字符, 跑满 5 轮/15 次可累积 40K+ token。
SDTM_RAG_WEB_RESULTS_PER_SEARCH=3
SDTM_RAG_WEB_RESULT_MAX_CHARS=1200

# 日配额兜底, 防"忘了关"跑飞。⚠ 这是**进程内**软闸 (类级计数), 重启即清零;
# 每请求的 MAX_SEARCHES 才是硬闸。真实额度以 Tavily 账户为准。
SDTM_RAG_WEB_DAILY_QUOTA=200
SDTM_RAG_WEB_TIMEOUT_S=30.0

# ─────────── C2R 画面 PDF 按需旁路 (PLAN_c2r_pdf_bypass.md; 默认关) ───────────
# 命中卡片的 OID → 画面 PDF 的页 → 渲染成图 → 挂进答题上下文。两份 PDF **不入向量库**
# (C2 DROP 判定不变), 这是检索之外的附加通道。
#
# ⚠ 前置: 系统需装 poppler 的 `pdftoppm` (macOS: brew install poppler)。
# ⚠ 开着但索引/PDF/pdftoppm 任一缺失 = **启动失败**, 不静默降级 —— 静默降级的表现是
#    "开了通道却一张图都不来", 完全无症状。
# ⚠ PDF 的 sha256 与索引记录不符也启动失败: 版本换了而页号没换 = 出典指着另一个画面。
# 索引生成 (改了 PDF 或 catalog 就要重跑): uv run python scripts/study/build_pdf_page_index.py
SDTM_RAG_PDF_CONTEXT_ENABLED=false
# 单次挂图页数上限。一页图 ≈1.5k prompt token (S0 实测), 6 页 ≈9k。推荐 6-8。
# 设 0 = 实质关闭 (会留一条 warning)。
SDTM_RAG_PDF_CONTEXT_MAX_PAGES=6
# 渲染 dpi。S0-3 实测 4 个可选模型在 110 下都能正确读出日语标签, 无需 150。
SDTM_RAG_PDF_CONTEXT_DPI=110
# 索引与 PNG 缓存的路径都从这个 study 代号派生。
SDTM_RAG_PDF_CONTEXT_STUDY_ID=st01
# 下面三个留空即可: 索引按 study 代号派生, 两份 PDF 的真名从 studies.local.yaml
# (pdf_workflow / pdf_annotated 两个键) 解析。只有自包含 service 目录才需要写死。
SDTM_RAG_PDF_PAGE_INDEX_PATH_OVERRIDE=
SDTM_RAG_PDF_WORKFLOW_PATH=
SDTM_RAG_PDF_ANNOTATED_PATH=
